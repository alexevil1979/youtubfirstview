; Имена «аккаунтов» для Chrome-профилей AutoView.
; Профили живут в ChromeProfiles\profile1 … profile5
; Если файла нет — на панели будет "Chrome profileN"

[labels]
1=Аккаунт 1
2=Аккаунт 2
3=Аккаунт 3
4=Аккаунт 4
5=Аккаунт 5

; HTTP/mixed порт Hiddify для проверки YouTube (не напрямую!)
[proxy]
hiddify=127.0.0.1:12334
