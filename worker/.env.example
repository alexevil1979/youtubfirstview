NODE_ENV=production

# Base URL of publications server (no trailing slash)
SERVER_API_URL=https://you.1tlt.ru

# Bearer token — never commit real values
WORKER_TOKEN=

# Unique instance id, e.g. worker-istanbul-01
WORKER_ID=worker-local-01

# youpub | video-tests
API_MODE=youpub

POLL_INTERVAL=10000
MAX_CONCURRENT_JOBS=2
MAX_RETRIES=4
FETCH_LIMIT=5

BROWSER_TIMEOUT=30000
PLAYBACK_TEST_SECONDS=5
MIN_FREE_RAM_MB=512

HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

LOG_LEVEL=info
SQLITE_PATH=./data/worker.db

# Claim lock TTL for video-tests mode (seconds)
CLAIM_TTL_SECONDS=300
